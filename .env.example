# TRUDI MCP Server — environment configuration

# IOC Enrichment (optional — server degrades gracefully without these)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# ── Reasoning backend ──────────────────────────────────────────────────────
# REASON_BACKEND selects which model powers the adversarial review loop.
# Auto-detected from available keys if not set explicitly.

# Default: Claude API (best quality, no server required).
# Recommended: Claude Opus on both reasoning surfaces (reason.* + dair.*).
# Add your key below and you're ready for a full-quality run from a fresh install.
REASON_BACKEND=claude
ANTHROPIC_API_KEY=                       # required — paste your sk-ant-... key here
REASON_MODEL=claude-opus-4-8             # the recommended default
# REASON_MODEL=claude-haiku-4-5-20251001 # faster/cheaper alternative for quick runs

# Alternative: any OpenAI-compatible endpoint
# (OpenAI, a local vLLM / SGLang / llama.cpp server, Ollama, HF endpoint)
# REASON_BACKEND=openai-compat
# REASON_URL=https://api.openai.com/v1        # or http://localhost:8000 for local vLLM
# REASON_API_KEY=sk-...                        # OpenAI key, HF token, or leave blank for local
# REASON_MODEL=gpt-4o-mini                     # or a local id, e.g. a Qwen3 / Titus GGUF


# ── DAIR Director Agent ───────────────────────────────────────────────────────
# Separate config from reason.* — can point to a different model or endpoint.
# Auto-detected from available keys if DAIR_BACKEND is not set explicitly.

DAIR_BACKEND=claude                     # "claude" or "openai-compat"
DAIR_MODEL=claude-opus-4-8              # matches REASON_MODEL above
# DAIR_MODEL=claude-haiku-4-5-20251001  # faster/cheaper alternative

# Alternative: separate OpenAI-compatible endpoint (e.g. second vLLM instance)
# DAIR_BACKEND=openai-compat
# DAIR_URL=http://localhost:8001         # separate from REASON_URL, or the same
# DAIR_API_KEY=hf_...
# DAIR_MODEL=<local model id>

# ── openai-compat: thinking models (Qwen3, DeepSeek-R1, gpt-oss, …) ──────────
# Thinking models spend a chain-of-thought BEFORE the answer and the server
# bills it against max_tokens. TRUDI keeps thinking ON and budgets for it:
# request budget = per-call max_tokens + THINKING_BUDGET; a budget-exhausted
# empty answer (finish_reason=length) is retried once at double the budget,
# capped at the ceiling. Set THINKING_BUDGET=0 for non-thinking models
# (non-thinking chat models, e.g. GPT-class) to keep the single-attempt legacy behaviour.
# If REASON_MODEL / DAIR_MODEL are unset the served id is auto-discovered
# from GET /v1/models — pin it explicitly when the server hosts several.
# Size these to the server: ceiling ≤ per-slot context (n_ctx / n_parallel)
# minus the largest prompt (~5.5k for DAIR). A retry doubles the budget up to
# the ceiling, and concurrent reason + DAIR calls share the server's KV cache —
# an oversized ceiling produces HTTP 500 "Context size has been exceeded".
# TRUDI_COMPAT_THINKING_BUDGET=8192
# TRUDI_COMPAT_MAX_TOKENS_CEILING=32768
# TRUDI_COMPAT_THINKING_GUIDANCE=         # brevity line appended to compat system
#                                         # prompts (built-in default; "off" disables)
# Per-surface thinking: DAIR + the mechanical checks run WITHOUT thinking by
# default (they are structured JSON against supplied text); hypothesize /
# evaluate_finding / synthesize / plan keep it. Keep every call under Claude
# Code's auto-background cutoff (CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS, 120 s by
# default) or the agent continues without the result. "none" = think everywhere.
# TRUDI_COMPAT_NO_THINK_TOOLS=dair_assess,reason_cite_check,reason_confidence_score,reason_audit_findings
# TRUDI_COMPAT_NO_THINK_MODE=both         # kwargs (chat_template_kwargs) | soft (/no_think) | both
# Inline reasoning delimiters stripped from `content` when the server has no
# parser for them. Items are a tag NAME (<name>…</name>) or a literal OPEN:CLOSE
# pair. Llama-Primus-Reasoning uses reserved tokens — run llama-server with
# `--special` so they are rendered, or reasoning and answer arrive concatenated.
# TRUDI_COMPAT_THINK_TAGS=think,reasoning,thought,<|reserved_special_token_0|>:<|reserved_special_token_1|>
# TRUDI_COMPAT_EXTRA_BODY=                # JSON merged into every request body
# TRUDI_REASON_TIMEOUT=1200               # a 27B at ~40 tok/s: ~4 min per 10k tokens
# TRUDI_DAIR_TIMEOUT=1200
#
# Reviewer context (feed the local model more of what it is judging, no extra
# round-trips). Default on for every backend.
# TRUDI_REASON_EVIDENCE_SCOPE=1           # prepend "evidence collected this run" so the
#                                         # reviewer stops demanding memory/PCAP nobody gathered
# TRUDI_REASON_EXPAND_CITED=1             # append the raw output of the call_ids a call cited
# TRUDI_REASON_CITED_BUDGET_CHARS=6000    # char pool for that appended block, divided per cid
# TRUDI_REASON_CITED_MAX_EXPAND=12        # max cited calls expanded per reviewer call; the rest
#                                         # are listed by id (tool output preferred over reason)
# TRUDI_REASON_CITED_FILE_FLOOR=700       # min chars of output-file read per expanded call, so
#                                         # high citation counts can't divide the pool to nothing
# TRUDI_REASON_CITED_FILE_BYTES=268435456 # when a cited call's stdout is a banner, scan up to this
#                                         # many bytes of its --csv/--json/-t output file, filtered
#                                         # to the finding's terms (relevant rows, whole-file scan)

# ── Tool execution timeouts (seconds) ────────────────────────────────────────
# Values below are tuned for an Opus reason+DAIR run on
# WSL2. Opus reasoning/DAIR calls routinely take 2-3 min, so the stock 120/300s
# floors time out — these raised defaults avoid that. Lower them for haiku.

TRUDI_DEFAULT_TIMEOUT=600     # most tools (regripper, yara, strings, etc.)
TRUDI_VOL_TIMEOUT=1800        # vol plugins, hashing dirs, heavy sleuthkit ops
TRUDI_PLASO_TIMEOUT=21600     # full disk timeline (6 hours)
TRUDI_REASON_TIMEOUT=600      # reasoning backend HTTP call (raised for Opus)
TRUDI_DAIR_TIMEOUT=600        # DAIR director (Opus can take 2-3 min)

# Volatility 3 symbol cache — must be writable by the current user
# Default: ~/.cache/volatility3/symbols (auto-created)
VOLATILITY_SYMBOLS=
