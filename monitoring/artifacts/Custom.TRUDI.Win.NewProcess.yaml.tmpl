name: Custom.TRUDI.Win.NewProcess
description: |
  TRUDI-managed (Windows): poll the process list and emit a row for any image
  path not in the operator-provided baseline. The Windows analogue of
  Custom.TRUDI.NewProcess — uses the cross-platform pslist() plugin rather than
  a Linux /proc walk.

  Poll-based (like the Linux detector) because the demo does not ship a Sysmon
  install; the trade-off is a poll-interval blind spot for very short-lived
  processes, acceptable for a demo where staged activity lingers.

type: CLIENT_EVENT

parameters:
  - name: BaselineImagePaths
    description: JSON array of image paths considered known-good.
    default: |
      ${baseline_image_paths}
  - name: BaselineProcessNames
    description: JSON array of process basenames considered known-good.
    default: |
      ${baseline_proc_names}
  - name: PollSeconds
    type: int
    default: 5

sources:
  - query: |
      LET baseline_paths <= parse_json_array(data=BaselineImagePaths)
      LET baseline_names <= parse_json_array(data=BaselineProcessNames)
      LET tick = SELECT * FROM clock(period=PollSeconds)
      SELECT * FROM foreach(row=tick, query={
        SELECT
          timestamp(epoch=now()) AS timestamp_utc,
          Exe AS image_path,
          Name AS process_name,
          Pid AS pid,
          Ppid AS ppid,
          CommandLine AS commandline,
          Username AS username,
          CreateTime AS started_utc
        FROM pslist()
        WHERE Exe
          AND NOT Exe IN baseline_paths
          AND NOT Name IN baseline_names
      })
