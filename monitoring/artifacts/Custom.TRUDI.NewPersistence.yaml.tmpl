name: Custom.TRUDI.NewPersistence
description: |
  TRUDI-managed: watch cron and systemd persistence files for new or changed
  content. Compare path|SHA256 identities, including existing crontabs.

type: CLIENT_EVENT

parameters:
  - name: BaselinePersistencePaths
    description: JSON array of file paths considered known-good.
    default: |
      ${baseline_persistence_paths}
  - name: WatchDirs
    description: |
      JSON array of files and glob patterns to walk every poll cycle. Directory
      entries end in `/*` (or `/**` for recursion); crontab files are explicit.
      Substituted from monitoring/render.py:PERSISTENCE_WATCH_GLOBS so the
      baseline snapshot globs the identical set.
    default: |
      ${watch_dirs}
  - name: BaselinePersistenceFingerprints
    description: JSON array of path|SHA256 identities. Old path-only baselines alert conservatively.
    default: |
      ${baseline_persistence_fingerprints}
  - name: PollSeconds
    description: How often to re-walk the watched dirs.
    type: int
    default: 15

sources:
  - query: |
      LET baseline <= parse_json_array(data=BaselinePersistenceFingerprints)
      LET watch <= parse_json_array(data=WatchDirs)
      LET tick = SELECT * FROM clock(period=PollSeconds)
      SELECT
        timestamp(epoch=now()) AS timestamp_utc,
        FullPath AS path,
        Size,
        mtime_utc,
        sha256,
        identity
      FROM foreach(
        row=tick,
        query={
          SELECT path AS FullPath, Size, mtime_utc, sha256, identity
          FROM Artifact.Custom.TRUDI.PersistenceSnapshot(WatchDirs=WatchDirs)
          WHERE NOT sha256 OR NOT identity IN baseline
        })
