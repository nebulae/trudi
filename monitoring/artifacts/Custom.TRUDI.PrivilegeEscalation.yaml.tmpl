name: Custom.TRUDI.PrivilegeEscalation
description: |
  TRUDI-managed: detect a privilege-escalation outcome — a process running as
  root whose image path is NOT in the baseline set of root-owned image paths.
  Catches the classic "land as an unprivileged user, then run a root-owned
  implant" pivot (e.g. via a sudo misconfiguration or SUID drop): the escalated
  binary appears as a novel root process.

  Zombies are skipped — a killed implant reaped by init briefly lingers as a
  defunct entry and must not read as a live root process.

type: CLIENT_EVENT

parameters:
  - name: BaselineRootImagePaths
    description: JSON array of image paths already seen running as root at baseline.
    default: |
      ${baseline_root_image_paths}
  - name: PollSeconds
    description: How often to walk the process list.
    type: int
    default: 5

sources:
  - query: |
      LET baseline <= parse_json_array(data=BaselineRootImagePaths)
      LET tick = SELECT * FROM clock(period=PollSeconds)
      SELECT * FROM foreach(row=tick, query={
        SELECT
          timestamp(epoch=now()) AS timestamp_utc,
          Exe AS image_path,
          Name AS process_name,
          Pid AS pid,
          Ppid AS ppid,
          CommandLine AS commandline,
          Username AS username,
          CreatedTime AS started_utc
        FROM Artifact.Linux.Sys.Pslist()
        WHERE Username = "root"
          AND Exe != ""
          AND NOT Exe IN baseline
          AND NOT Status =~ "zombie"
      })
