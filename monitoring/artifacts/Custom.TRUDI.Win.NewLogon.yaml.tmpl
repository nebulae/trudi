name: Custom.TRUDI.Win.NewLogon
description: |
  TRUDI-managed (Windows): the lateral-movement / RDP signal. Follows the
  Security event log and emits a row for an interactive-remote (type 10, RDP)
  or network (type 3) logon whose source address is not in the baseline
  allowlist. This is the detector the real victim-a → victim-win RDP session
  trips: a genuine 4624 type-10 with IpAddress = the beachhead.

  watch_evtx() tails the .evtx file, so this is a true event-stream detector
  (not a poll). 4625 (failed logon) is included so a brute-force/credential
  spray against RDP also surfaces. Blank/local source addresses ("-", "::1",
  "127.0.0.1") are dropped — only a real remote source alerts.

type: CLIENT_EVENT

parameters:
  - name: BaselineLogonSources
    description: JSON array of source IPs seen logging on at baseline (allow).
    default: |
      ${baseline_logon_sources}
  - name: SecurityChannel
    default: 'C:/Windows/System32/winevt/Logs/Security.evtx'

sources:
  - query: |
      LET baseline <= parse_json_array(data=BaselineLogonSources)
      SELECT
        timestamp(epoch=System.TimeCreated.SystemTime) AS timestamp_utc,
        System.EventID.Value AS event_id,
        System.EventRecordID AS event_record_id,
        System.Channel AS channel,
        EventData.TargetUserName AS account,
        EventData.TargetDomainName AS domain,
        EventData.IpAddress AS source_ip,
        EventData.LogonType AS logon_type,
        EventData.TargetLogonId AS logon_id,
        EventData.WorkstationName AS source_host,
        System.Computer AS computer
      FROM watch_evtx(filename=SecurityChannel)
      WHERE event_id IN (4624, 4625)
        AND logon_type IN (3, 10)
        AND source_ip
        AND NOT source_ip IN ("-", "::1", "127.0.0.1")
        AND NOT source_ip IN baseline
